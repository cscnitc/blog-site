---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

export interface Props {
  announcements: CollectionEntry<"announcements">[];
}

const { announcements = [] } = Astro.props;
const latest = announcements[0];

const getAnnouncementSlug = (id: string) => id.replace(/\.md$/, "");
const slug = latest ? getAnnouncementSlug(latest.id) : "";
const href = `/announcements/${slug}`;

const pubDateStr = latest
  ? dayjs(latest.data.pubDatetime).tz(SITE.timezone).format("YYYY-MM-DD")
  : "";
---

{
  latest && (
    <div
      id="announcements-window"
      class="relative w-full rounded-none border-2 border-border/80 hover:border-accent/60 bg-[#050805]/95 p-5 sm:p-6 font-mono shadow-[0_0_20px_rgba(0,255,65,0.1)] hover:shadow-[0_0_28px_rgba(0,255,65,0.22)] transition-all duration-300"
      style="background-image: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.45) 1px, transparent 1px, transparent 3px);"
    >
      <!-- 4 Corner Edge Items (Always visible, prominent neon green brackets) -->
      <span class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-accent pointer-events-none z-10" aria-hidden="true"></span>
      <span class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-accent pointer-events-none z-10" aria-hidden="true"></span>
      <span class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-accent pointer-events-none z-10" aria-hidden="true"></span>
      <span class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-accent pointer-events-none z-10" aria-hidden="true"></span>

      <!-- Top Bar: Badge, Label & Close -->
      <div class="flex items-center justify-between pb-3 mb-3 border-b-2 border-border/40">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center justify-center leading-none bg-accent text-black font-mono font-bold text-[11px] px-2 pt-[5px] pb-[3px] rounded-none tracking-wider">
            BROADCAST
          </span>
          <span class="text-heading2 font-mono font-semibold text-xs tracking-wider">
            ANNOUNCEMENTS:
          </span>
        </div>
        <button
          id="close-announcements-btn"
          type="button"
          class="inline-flex items-center justify-center leading-none border-2 border-border/80 hover:border-accent text-foreground/70 hover:text-accent font-mono text-xs px-2 pt-[5px] pb-[3px] transition-colors cursor-pointer"
          aria-label="Close announcements box"
          title="Dismiss announcements"
        >
          [ x ]
        </button>
      </div>

      <!-- Announcement Content Area -->
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <!-- Text details -->
        <div class="flex-1 space-y-2">
          <a href={href} class="block">
            <h2
              transition:name={slugifyStr(latest.data.title)}
              class="m-0 text-2xl sm:text-3xl font-bold text-white hover:text-accent transition-colors tracking-wide leading-tight"
            >
              {latest.data.title}
            </h2>
          </a>

          <div class="text-xs sm:text-sm font-mono text-heading2/90 flex flex-wrap items-center gap-1.5 pt-1">
            <span>: {pubDateStr}</span>
            <span class="text-foreground/40 mx-1">|</span>
            <span>Tags:</span>
            {latest.data.tags?.map((tag) => (
              <a
                href={`/tags/${slugifyStr(tag)}`}
                class="text-heading2 hover:text-accent hover:underline decoration-dashed"
              >
                [{tag}]
              </a>
            ))}
          </div>

          <p class="text-xs sm:text-sm text-foreground/85 leading-relaxed max-w-4xl pt-1">
            {latest.data.description}
          </p>
        </div>

        <!-- Button on the right with border radius and glow feel -->
        <div class="flex flex-col sm:flex-row lg:flex-col gap-2.5 shrink-0 justify-center">
          <a
            href={href}
            class="inline-flex items-center justify-center rounded-md border-2 border-accent bg-accent text-black font-mono font-bold text-xs sm:text-sm px-5 py-2.5 hover:bg-heading2 transition-all shadow-[0_0_16px_rgba(0,255,65,0.35)] hover:shadow-[0_0_24px_rgba(0,255,65,0.55)] text-center tracking-wide"
          >
            [ READ MORE &gt;_ ]
          </a>
        </div>
      </div>
    </div>
  )
}

<script>
  function setupAnnouncementsClose() {
    const closeBtn = document.getElementById("close-announcements-btn");
    const container = document.getElementById("announcements-section");

    if (closeBtn && container) {
      closeBtn.addEventListener("click", () => {
        container.style.opacity = "0";
        container.style.transform = "scale(0.98)";
        container.style.transition = "opacity 0.2s ease, transform 0.2s ease";
        setTimeout(() => {
          container.style.display = "none";
        }, 200);
      });
    }
  }

  document.addEventListener("astro:page-load", setupAnnouncementsClose);
  setupAnnouncementsClose();
</script>
