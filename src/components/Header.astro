---
import Hr from "./Hr.astro";
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";
import { Image } from "astro:assets";
import cscLogo from "@/assets/images/csc-logo-black.png";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
    pathname.endsWith("/") && pathname !== "/"
        ? pathname.slice(0, -1)
        : pathname;

const isActive = (path: string) => {
    const currentPathArray = currentPath.split("/").filter((p) => p.trim());
    const pathArray = path.split("/").filter((p) => p.trim());

    return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<header class="w-full">
    <a
        id="skip-to-content"
        href="#main-content"
        class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
    >
        Skip to content
    </a>
    <div
        id="nav-container"
        class="mx-auto flex w-full max-w-full flex-col items-center justify-between md:flex-row px-2.5 sm:px-5 xl:px-8"
    >
        <div
            id="top-nav-wrap"
            class="flex w-full flex-col bg-background md:flex-row md:items-center md:justify-between md:gap-4"
        >
            <div
                class="flex w-full md:w-auto md:shrink-0 items-center justify-between py-3 px-0 gap-4 md:py-5"
            >
                <a href="/" class="shrink-0 flex items-center">
                    <Image
                        src={cscLogo}
                        alt="CSC Logo"
                        width={240}
                        height={34}
                        class="h-8 w-auto lg:h-10 shrink-0"
                        loading="eager"
                    />
                </a>
                <button
                    id="menu-btn"
                    class="focus-outline shrink-0 p-2 md:hidden"
                    aria-label="Open Menu"
                    aria-expanded="false"
                    aria-controls="menu-items"
                >
                    <IconX id="close-icon" class="hidden" />
                    <IconMenuDeep id="menu-icon" />
                </button>
            </div>
            <nav
                id="nav-menu"
                class="w-full md:w-auto md:flex-1 md:min-w-0 md:flex md:flex-row md:justify-end md:items-center md:space-x-2 md:py-0"
            >
                <ul
                    id="menu-items"
                    class:list={[
                        "mt-0 grid w-full grid-cols-2 place-content-center gap-2 pb-4 px-4 items-center font-mono",
                        "hidden",
                        "md:mt-0 md:flex md:w-auto md:gap-x-1.5 lg:gap-x-2.5 md:gap-y-0 md:pb-0 md:px-0",
                    ]}
                >
                    <li class="col-span-2 md:text-nowrap">
                        <a
                            href="/posts"
                            class:list={[
                                "block font-mono text-xs lg:text-sm font-medium transition-all rounded-md px-2.5 py-1.5 md:py-1 text-center",
                                isActive("/posts")
                                    ? "text-accent border border-accent bg-accent/5 shadow-[0_0_10px_rgba(0,255,65,0.4)]"
                                    : "text-foreground/80 hover:text-accent hover:border hover:border-accent/40 border border-transparent",
                            ]}
                        >
                            [ 01 // INTEL ]
                        </a>
                    </li>
                    <li class="col-span-2 md:text-nowrap">
                        <a
                            href="/events"
                            class:list={[
                                "block font-mono text-xs lg:text-sm font-medium transition-all rounded-md px-2.5 py-1.5 md:py-1 text-center",
                                isActive("/events")
                                    ? "text-accent border border-accent bg-accent/5 shadow-[0_0_10px_rgba(0,255,65,0.4)]"
                                    : "text-foreground/80 hover:text-accent hover:border hover:border-accent/40 border border-transparent",
                            ]}
                        >
                            [ 02 // CTF &amp; OPS ]
                        </a>
                    </li>
                    <li class="col-span-2 md:text-nowrap">
                        <a
                            href="/team"
                            class:list={[
                                "block font-mono text-xs lg:text-sm font-medium transition-all rounded-md px-2.5 py-1.5 md:py-1 text-center",
                                isActive("/team")
                                    ? "text-accent border border-accent bg-accent/5 shadow-[0_0_10px_rgba(0,255,65,0.4)]"
                                    : "text-foreground/80 hover:text-accent hover:border hover:border-accent/40 border border-transparent",
                            ]}
                        >
                            [ 03 // CREW ]
                        </a>
                    </li>
                    <li class="col-span-2 md:text-nowrap">
                        <a
                            href="/achievements"
                            class:list={[
                                "block font-mono text-xs lg:text-sm font-medium transition-all rounded-md px-2.5 py-1.5 md:py-1 text-center",
                                isActive("/achievements")
                                    ? "text-accent border border-accent bg-accent/5 shadow-[0_0_10px_rgba(0,255,65,0.4)]"
                                    : "text-foreground/80 hover:text-accent hover:border hover:border-accent/40 border border-transparent",
                            ]}
                        >
                            [ 04 // HALL OF FAME ]
                        </a>
                    </li>
                    <li class="col-span-2 md:text-nowrap">
                        <a
                            href="/sponsors"
                            class:list={[
                                "block font-mono text-xs lg:text-sm font-medium transition-all rounded-md px-2.5 py-1.5 md:py-1 text-center",
                                isActive("/sponsors")
                                    ? "text-accent border border-accent bg-accent/5 shadow-[0_0_10px_rgba(0,255,65,0.4)]"
                                    : "text-foreground/80 hover:text-accent hover:border hover:border-accent/40 border border-transparent",
                            ]}
                        >
                            [ 05 // SPONSORS ]
                        </a>
                    </li>
                    <li class="col-span-2 md:text-nowrap">
                        <a
                            href="/about"
                            class:list={[
                                "block font-mono text-xs lg:text-sm font-medium transition-all rounded-md px-2.5 py-1.5 md:py-1 text-center border text-accent",
                                isActive("/about")
                                    ? "border-accent bg-accent/15 shadow-[0_0_16px_rgba(0,255,65,0.55)]"
                                    : "border-accent/70 bg-accent/10 shadow-[0_0_12px_rgba(0,255,65,0.35)] hover:border-accent hover:bg-accent/15 hover:shadow-[0_0_18px_rgba(0,255,65,0.55)]",
                            ]}
                        >
                            [ 06 // WHOAMI ]
                        </a>
                    </li>
                    {
                        SITE.showArchives && (
                            <li class="col-span-2">
                                <LinkButton
                                    href="/archives"
                                    class:list={[
                                        "focus-outline flex justify-center p-3 md:p-1",
                                        {
                                            "active-nav [&>svg]:stroke-accent":
                                                isActive("/archives"),
                                         },
                                    ]}
                                    ariaLabel="archives"
                                    title="Archives"
                                >
                                    <IconArchive class="hidden md:inline-block" />
                                    <span class="md:sr-only">Archives</span>
                                </LinkButton>
                            </li>
                        )
                    }
                    <li class="col-span-2 flex items-center justify-center">
                        <LinkButton
                            href="/search"
                            class:list={[
                                "focus-outline flex p-2 md:p-1 hover:text-accent",
                                {
                                    "[&>svg]:stroke-accent":
                                        isActive("/search"),
                                },
                            ]}
                            ariaLabel="search"
                            title="Search"
                        >
                            <IconSearch />
                            <span class="sr-only">Search</span>
                        </LinkButton>
                    </li>
                    {
                        SITE.lightAndDarkMode && (
                            <li class="col-span-1 flex items-center justify-center">
                                <button
                                    id="theme-btn"
                                    class="focus-outline relative size-10 p-2 md:size-8 hover:[&>svg]:stroke-accent"
                                    title="Toggles light & dark"
                                    aria-label="auto"
                                    aria-live="polite"
                                >
                                    <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                                    <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                                </button>
                            </li>
                        )
                    }
                </ul>
            </nav>
        </div>
    </div>
    <Hr />
</header>

<script>
    function initNav() {
        const menuItems = document.querySelector("#menu-items");
        const menuIcon = document.querySelector("#menu-icon");
        const closeIcon = document.querySelector("#close-icon");
        const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");

        if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

        // Always reset mobile menu to closed state on page load / navigation
        menuBtn.setAttribute("aria-expanded", "false");
        menuBtn.setAttribute("aria-label", "Open Menu");
        menuItems.classList.add("hidden");
        menuIcon.classList.remove("hidden");
        closeIcon.classList.add("hidden");

        // Clone to strip stale event listeners accumulated across view transitions
        const freshBtn = menuBtn.cloneNode(true) as HTMLButtonElement;
        menuBtn.parentElement?.replaceChild(freshBtn, menuBtn);

        freshBtn.addEventListener("click", () => {
            const btn = document.querySelector<HTMLButtonElement>("#menu-btn");
            const items = document.querySelector("#menu-items");
            const mIcon = document.querySelector("#menu-icon");
            const cIcon = document.querySelector("#close-icon");
            if (!btn || !items || !mIcon || !cIcon) return;

            const isOpen = btn.getAttribute("aria-expanded") === "true";
            btn.setAttribute("aria-expanded", isOpen ? "false" : "true");
            btn.setAttribute("aria-label", isOpen ? "Open Menu" : "Close Menu");
            items.classList.toggle("hidden", isOpen);
            mIcon.classList.toggle("hidden", !isOpen);
            cIcon.classList.toggle("hidden", isOpen);
        });
    }

    initNav();
    document.addEventListener("astro:after-swap", initNav);
</script>
