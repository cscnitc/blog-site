---
import type { AlumniMember, TeamMember } from "../data/team/team";
import { Image } from "astro:assets";
const { member } = Astro.props as { member: TeamMember | AlumniMember };
import GithubIcon from "../assets/icons/github.svg";
import LinkedInIcon from "../assets/icons/IconLinkedin.svg";

const tier = "tier" in member ? member.tier : "alumni";
const isExec = tier === "exec";
const isHead = tier === "head";
const roleLines = "role" in member ? member.role.split("\n") : [];

const cardClasses = isExec
  ? "border-2 border-accent/80 hover:border-accent bg-[#050c07] shadow-[0_0_24px_rgba(0,255,65,0.18)] hover:shadow-[0_0_32px_rgba(0,255,65,0.35)]"
  : isHead
    ? "border-2 border-heading2/55 hover:border-accent bg-[#050a06] shadow-[0_0_16px_rgba(60,252,124,0.1)] hover:shadow-[0_0_24px_rgba(0,255,65,0.25)]"
    : "border border-border/75 hover:border-accent/60 bg-[#050805]/90 hover:shadow-[0_0_18px_rgba(0,255,65,0.14)]";
---

<div
  class:list={[
    "flex h-full w-full flex-col overflow-hidden rounded-lg transition-all duration-300 group relative",
    cardClasses,
  ]}
>
  <!-- Fixed 1:1 Square Portrait (uniform across all cards) -->
  <div class="relative aspect-square w-full shrink-0 overflow-hidden bg-black/60">
    {
      typeof member.avatar === "string" ? (
        <img
          class="!h-full !w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
          src={member.avatar}
          alt={member.name}
          loading="eager"
        />
      ) : (
        <Image
          class="!h-full !w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
          src={member.avatar}
          alt={member.name}
          loading="eager"
        />
      )
    }
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-[#050805] to-transparent"
      aria-hidden="true"
    />
  </div>

  <!-- Info Block (clean, no extra boxes) -->
  <div class="flex flex-1 flex-col justify-between p-3 sm:p-4">
    <div>
      <div class="flex items-start justify-between gap-2">
        <div class="min-w-0">
          <h3 class="text-sm sm:text-lg font-bold text-white group-hover:text-accent transition-colors leading-snug break-words">
            {
              member.website ? (
                <a
                  href={
                    member.website.startsWith("http")
                      ? member.website
                      : `https://${member.website}`
                  }
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:underline decoration-dashed"
                >
                  {member.name}
                </a>
              ) : (
                member.name
              )
            }
          </h3>
          {
            "alias" in member && member.alias && (
              <div class="text-[11px] sm:text-xs font-mono text-foreground/55">
                @{member.alias}
              </div>
            )
          }
        </div>

        <div class="flex shrink-0 items-center gap-2 pt-0.5">
          {
            member.github && (
              <a
                href={member.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${member.name} GitHub`}
                class="text-foreground/80 hover:text-accent transition-colors"
              >
                <GithubIcon class="h-5 w-5 fill-current" />
              </a>
            )
          }
          {
            member.linkedIn && (
              <a
                href={member.linkedIn}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${member.name} LinkedIn`}
                class="text-foreground/80 hover:text-accent transition-colors"
              >
                <LinkedInIcon class="h-5 w-5 text-current" />
              </a>
            )
          }
          {
            member.website && (
              <a
                href={
                  member.website.startsWith("http")
                    ? member.website
                    : `https://${member.website}`
                }
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${member.name} Website`}
                class="text-foreground/80 hover:text-accent transition-colors"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="2" y1="12" x2="22" y2="12" />
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                </svg>
              </a>
            )
          }
        </div>
      </div>

      {
        roleLines.length > 0 && (
          <div
            class:list={[
              "mt-2 space-y-0.5 text-[11px] sm:text-sm font-mono font-semibold leading-snug",
              isExec
                ? "text-accent"
                : isHead
                  ? "text-heading2"
                  : "text-heading2/80",
            ]}
          >
            {roleLines.map((line) => (
              <p class="m-0">{line}</p>
            ))}
          </div>
        )
      }
    </div>

    {
      "domains" in member && member.domains && member.domains.length > 0 && (
        <p class="mt-2.5 pt-2 border-t border-border/35 text-[10px] sm:text-[11px] font-mono text-foreground/65 leading-relaxed">
          {member.domains.join(" · ")}
        </p>
      )
    }
  </div>
</div>
