---
import type { AlumniMember, TeamMember } from "../data/team/team";
import { Image } from "astro:assets";
const { member } = Astro.props as { member: TeamMember | AlumniMember };
import GithubIcon from "../assets/icons/github.svg";
import LinkedInIcon from "../assets/icons/IconLinkedin.svg";
---

<div
    class="flex w-full items-center gap-5 sm:gap-6 rounded-md border-2 border-border/85 hover:border-accent/70 bg-[#050805]/90 p-5 shadow-[0_0_16px_rgba(0,255,65,0.06)] hover:shadow-[0_0_24px_rgba(0,255,65,0.22)] transition-all duration-300 group relative"
>
    {
        typeof member.avatar === "string" ? (
            <img
                class="h-[110px] w-[110px] sm:h-[120px] sm:w-[120px] shrink-0 rounded-md border-2 border-border/60 object-cover"
                src={member.avatar}
                alt={member.name}
                loading="eager"
                height="120"
                width="120"
            />
        ) : (
            <Image
                class="h-[110px] w-[110px] sm:h-[120px] sm:w-[120px] shrink-0 rounded-md border-2 border-border/60 object-cover"
                src={member.avatar}
                alt={member.name}
                loading="eager"
                height={120}
                width={120}
            />
        )
    }
    <div class="flex-1 text-left min-w-0">
        <h3 class="mb-1 text-lg sm:text-xl font-bold text-white group-hover:text-accent transition-colors truncate">
            {
                member.website ? (
                    <a
                        href={
                            member.website.startsWith("http")
                                ? member.website
                                : `https://${member.website}`
                        }
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:underline decoration-dashed"
                    >
                        {member.name}
                    </a>
                ) : (
                    member.name
                )
            }
        </h3>
        {
            "role" in member && (
                <p class="mb-3 text-xs sm:text-sm font-mono text-heading2/90 font-medium">
                    {member.role}
                </p>
            )
        }
        <div class="flex items-center gap-3">
            {
                member.github && (
                    <a
                        href={member.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${member.name} GitHub`}
                        class="inline-flex text-foreground/70 hover:text-accent transition-colors"
                    >
                        <GithubIcon class="h-5 w-5 fill-current" />
                    </a>
                )
            }
            {
                member.linkedIn && (
                    <a
                        href={member.linkedIn}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${member.name} LinkedIn`}
                        class="inline-flex text-foreground/70 hover:text-accent transition-colors"
                    >
                        <LinkedInIcon class="h-5 w-5 text-current" />
                    </a>
                )
            }
            {
                member.website && (
                    <a
                        href={
                            member.website.startsWith("http")
                                ? member.website
                                : `https://${member.website}`
                        }
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${member.name} Website`}
                        class="inline-flex text-foreground/70 hover:text-accent transition-colors"
                    >
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="2" y1="12" x2="22" y2="12" />
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                        </svg>
                    </a>
                )
            }
        </div>
    </div>
</div>
