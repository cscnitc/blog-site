---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";
import Sponsor1Logo from "../../assets/icons/sponsor-1.webp";
import Sponsor2Logo from "../../assets/icons/sponsor-2.webp";
---

<Layout title="Sponsors">
    <Header />
    <main id="main-content" class="w-full">
        <div class="max-w-6xl mx-auto py-8 px-4 sm:px-8">
            <div class="mb-10 border-b-2 border-border/60 pb-3">
                <div class="text-xs sm:text-sm font-mono text-heading2 tracking-widest uppercase">
                    05 // PARTNERS &amp; SUPPORTERS
                </div>
                <h1 class="m-0 text-3xl sm:text-4xl font-bold text-white tracking-wide flex items-center gap-1 mt-1">
                    Sponsors <span class="text-accent animate-pulse">_</span>
                </h1>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Sponsor 1 -->
                <div
                    class="rounded-md border-2 border-border/85 hover:border-accent/70 bg-[#050805]/90 p-6 shadow-[0_0_16px_rgba(0,255,65,0.06)] hover:shadow-[0_0_24px_rgba(0,255,65,0.22)] transition-all duration-300 group h-full"
                >
                    <div
                        class="flex flex-col sm:flex-row items-center sm:items-start gap-5 sm:gap-6 h-full"
                    >
                        <a
                            href="https://connectedpapers.com/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="shrink-0 rounded-md border-2 border-border/60 p-2 bg-black/40"
                            aria-label="Connected Papers"
                        >
                            <Image
                                src={Sponsor1Logo}
                                alt="Connected Papers logo"
                                width={128}
                                height={128}
                                class="h-24 w-24 sm:h-28 sm:w-28 object-contain"
                                loading="eager"
                            />
                        </a>
                        <div class="text-center sm:text-left flex-1 min-w-0">
                            <h2 class="text-xl sm:text-2xl font-bold text-white group-hover:text-accent transition-colors">
                                <a
                                    href="https://connectedpapers.com/"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="hover:underline decoration-dashed"
                                >
                                    Connected Papers
                                </a>
                            </h2>
                            <p class="mt-2 text-sm text-foreground/85 leading-relaxed">
                                Explore and discover academic papers through
                                visual, graph-based research maps.
                            </p>
                            <div class="mt-3">
                                <a
                                    href="https://connectedpapers.com/"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-1 text-xs sm:text-sm font-mono font-semibold text-heading2 hover:text-accent transition-colors"
                                >
                                    <span>VISIT PLATFORM &gt;_</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sponsor 2 -->
                <div
                    class="rounded-md border-2 border-border/85 hover:border-accent/70 bg-[#050805]/90 p-6 shadow-[0_0_16px_rgba(0,255,65,0.06)] hover:shadow-[0_0_24px_rgba(0,255,65,0.22)] transition-all duration-300 group h-full"
                >
                    <div
                        class="flex flex-col sm:flex-row items-center sm:items-start gap-5 sm:gap-6 h-full"
                    >
                        <a
                            href="https://hackerdna.com/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="shrink-0 rounded-md border-2 border-border/60 p-2 bg-black/40"
                            aria-label="HackerDNA"
                        >
                            <Image
                                src={Sponsor2Logo}
                                alt="HackerDNA logo"
                                width={128}
                                height={128}
                                class="h-24 w-24 sm:h-28 sm:w-28 object-contain rounded-md"
                                loading="eager"
                            />
                        </a>
                        <div class="text-center sm:text-left flex-1 min-w-0">
                            <h2 class="text-xl sm:text-2xl font-bold text-white group-hover:text-accent transition-colors">
                                <a
                                    href="https://hackerdna.com/"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="hover:underline decoration-dashed"
                                >
                                    HackerDNA
                                </a>
                            </h2>
                            <p class="mt-2 text-sm text-foreground/85 leading-relaxed">
                                Learn hacking by breaking and fixing real systems in your browser.
                            </p>
                            <div class="mt-3">
                                <a
                                    href="https://hackerdna.com/"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-1 text-xs sm:text-sm font-mono font-semibold text-heading2 hover:text-accent transition-colors"
                                >
                                    <span>VISIT PLATFORM &gt;_</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sponsorship Callout Box -->
            <div
                class="mt-10 rounded-md border-2 border-border/85 hover:border-accent/70 bg-[#050805]/95 p-8 text-center shadow-[0_0_16px_rgba(0,255,65,0.06)] hover:shadow-[0_0_24px_rgba(0,255,65,0.22)] transition-all duration-300"
            >
                    <div class="text-xs font-mono font-bold text-heading2 tracking-widest uppercase mb-2">
                        // SUPPORT KATTANGALSEC
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">
                        Interested in sponsoring?
                    </h2>
                    <p class="text-sm text-foreground/85 max-w-2xl mx-auto mb-6 leading-relaxed">
                        Your sponsorship powers our security workshops, national CTF tournaments,
                        and research hardware infrastructure. Partners receive brand recognition,
                        talent recruitment pipelines, and direct engagement with India's top cybersecurity talents.
                    </p>
                    <a
                        href="mailto:csc@nitc.ac.in"
                        class="inline-block px-6 py-2.5 rounded-md border-2 border-accent bg-accent text-black font-mono font-bold text-xs sm:text-sm hover:bg-heading2 shadow-[0_0_14px_rgba(0,255,65,0.35)] hover:shadow-[0_0_22px_rgba(0,255,65,0.55)] transition-all"
                    >
                        [ CONTACT US &gt;_ ]
                    </a>
                </div>
        </div>
    </main>
    <Footer />
</Layout>
