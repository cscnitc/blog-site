---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";
import { achievements, categories } from "../../data/achievements/achievements";

// Sort achievements newest first
const sorted = [...achievements].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

// All categories that actually have achievements
const usedCategories = categories.filter((c) =>
  sorted.some((a) => a.category === c)
);
---

<Layout title="Hall of Fame | Achievements">
  <Header />
  <main id="main-content" class="w-full pb-16">
    <!-- Page Header -->
    <div class="max-w-6xl mx-auto px-4 sm:px-8 xl:px-12 pt-6 sm:pt-8">
      <div class="mb-8 border-b-2 border-border/60 pb-3">
        <div class="text-xs sm:text-sm font-mono text-heading2 tracking-widest uppercase">
          04 // HALL OF FAME &amp; ACCOLADES
        </div>
        <h1 class="m-0 text-3xl sm:text-4xl font-bold text-white tracking-wide flex items-center gap-1 mt-1">
          Achievements <span class="text-accent animate-pulse">_</span>
        </h1>
      </div>
    </div>

    <!-- Main 2-column layout -->
    <div class="max-w-6xl mx-auto px-4 sm:px-8 xl:px-12 font-mono">
      <div class="flex flex-col lg:flex-row gap-8">

        <!-- ── LEFT SIDEBAR: Category Filter ─────────────────────── -->
        <aside class="lg:w-52 xl:w-60 shrink-0">
          <div class="lg:sticky lg:top-6">
            <div class="text-xs font-bold text-heading2 tracking-widest uppercase mb-3">
              // FILTER
            </div>
            <ul class="space-y-1 text-sm font-mono" id="category-filter">
              <li>
                <button
                  data-cat="all"
                  class="cat-btn w-full text-left px-3 py-2 rounded-md border-2 border-accent bg-accent/10 text-accent font-bold tracking-wide transition-all shadow-[0_0_10px_rgba(0,255,65,0.18)] hover:shadow-[0_0_16px_rgba(0,255,65,0.35)]"
                >
                  &gt; All Achievements
                </button>
              </li>
              {usedCategories.map((cat) => (
                <li>
                  <button
                    data-cat={cat}
                    class="cat-btn w-full text-left px-3 py-2 rounded-md border-2 border-border/60 text-foreground/75 hover:text-accent hover:border-accent/50 transition-all"
                  >
                    {cat}
                  </button>
                </li>
              ))}
            </ul>
          </div>
        </aside>

        <!-- ── RIGHT: Achievements Feed ───────────────────────────── -->
        <div class="flex-1 min-w-0" id="achievements-feed">

          {sorted.map((achievement) => {
            const img = achievement.image;
            return (
              <article
                data-category={achievement.category}
                class="achievement-card group mb-6 rounded-md border-2 border-border/70 hover:border-accent/60 bg-[#050805]/90 hover:bg-[#071008]/95 shadow-[0_0_12px_rgba(0,255,65,0.04)] hover:shadow-[0_0_22px_rgba(0,255,65,0.16)] transition-all duration-300"
              >
                <!-- Card Header -->
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 px-5 pt-5 pb-3 border-b border-border/40">
                  <div class="flex-1 min-w-0">
                    <!-- Category badge -->
                    <span class="inline-flex items-center justify-center leading-none text-[10px] font-bold tracking-widest uppercase text-accent/80 border border-accent/30 rounded px-1.5 pt-[5px] pb-[3px] mb-2">
                      {achievement.category}
                    </span>
                    <h2 class="text-sm sm:text-base font-bold text-white group-hover:text-accent transition-colors leading-snug">
                      {achievement.title}
                    </h2>
                  </div>
                  <div class="shrink-0 text-xs text-foreground/50 font-mono text-right whitespace-nowrap pt-0.5">
                    : {achievement.dateLabel}
                  </div>
                </div>

                <!-- Card Body -->
                <div class="px-5 py-4">
                  <p class="text-xs sm:text-sm text-foreground/80 leading-relaxed">
                    {achievement.description}
                  </p>

                  <!-- Image if present -->
                  {img && (
                    <button
                      type="button"
                      class="lightbox-trigger mt-4 block w-full overflow-hidden rounded-md border border-border/50 hover:border-accent/60 transition-colors cursor-zoom-in"
                      aria-label={`Expand image for ${achievement.title}`}
                    >
                      <Image
                        src={img}
                        alt={achievement.title}
                        class="w-full max-h-96 object-cover shadow-[0_0_12px_rgba(0,0,0,0.5)]"
                      />
                    </button>
                  )}

                  <!-- Links -->
                  {achievement.links && achievement.links.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-2">
                      {achievement.links.map((link) => (
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1 text-xs font-mono text-heading2 hover:text-accent border border-border/60 hover:border-accent/50 rounded px-2.5 py-1 transition-all hover:shadow-[0_0_8px_rgba(0,255,65,0.2)]"
                        >
                          <span class="text-accent/70">&gt;</span> {link.label} ↗
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            );
          })}

          <!-- Empty state (shown by JS when filter has no results) -->
          <div id="no-results" class="hidden text-center py-16 text-foreground/50 font-mono text-sm">
            &gt; No achievements found in this category.
          </div>
        </div>
      </div>
    </div>

    <!-- Lightbox Modal -->
    <div
      id="lightbox"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 backdrop-blur-sm p-4 cursor-pointer"
      role="dialog"
      aria-modal="true"
      aria-label="Expanded image view"
    >
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-w-[92vw] max-h-[88vh] rounded-md border border-border/60 shadow-[0_0_30px_rgba(0,255,65,0.18)] object-contain cursor-default"
      />
    </div>
  </main>
  <Footer />
</Layout>

<script is:inline>
  function initFilter() {
    const buttons = document.querySelectorAll(".cat-btn");
    const cards = document.querySelectorAll(".achievement-card");
    const noResults = document.getElementById("no-results");

    if (!buttons.length) return;

    function setActive(btn) {
      buttons.forEach((b) => {
        b.classList.remove(
          "border-accent", "bg-accent/10", "text-accent", "font-bold",
          "shadow-[0_0_10px_rgba(0,255,65,0.18)]", "hover:shadow-[0_0_16px_rgba(0,255,65,0.35)]"
        );
        b.classList.add("border-border/60", "text-foreground/75");
      });
      btn.classList.remove("border-border/60", "text-foreground/75");
      btn.classList.add(
        "border-accent", "bg-accent/10", "text-accent", "font-bold",
        "shadow-[0_0_10px_rgba(0,255,65,0.18)]"
      );
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.getAttribute("data-cat");
        setActive(btn);

        let visible = 0;
        cards.forEach((card) => {
          const matches = cat === "all" || card.getAttribute("data-category") === cat;
          card.style.display = matches ? "" : "none";
          if (matches) visible++;
        });

        if (noResults) noResults.classList.toggle("hidden", visible > 0);
      });
    });
  }

  function initLightbox() {
    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById("lightbox-img");
    const triggers = document.querySelectorAll(".lightbox-trigger");

    if (!lightbox || !lightboxImg || !triggers.length) return;

    function closeLightbox() {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      lightboxImg.src = "";
      lightboxImg.alt = "";
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const img = trigger.querySelector("img");
        if (!img) return;
        lightboxImg.src = img.currentSrc || img.src;
        lightboxImg.alt = img.alt || "";
        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");
      });
    });

    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) {
        closeLightbox();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !lightbox.classList.contains("hidden")) {
        closeLightbox();
      }
    });
  }

  initFilter();
  initLightbox();
  document.addEventListener("astro:after-swap", () => {
    initFilter();
    initLightbox();
  });
</script>
