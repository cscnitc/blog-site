---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

export const getStaticPaths = (async ({ paginate }) => {
  const blogPosts = await getCollection("blog", ({ data }) => !data.draft);
  const writeups = await getCollection("writeups");

  const allPosts = [...blogPosts, ...writeups];

  return paginate(getSortedPosts(allPosts as any), { pageSize: SITE.postPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const backUrl = SITE.showBackButton ? Astro.url.pathname : "/";
---

<Layout title={`Posts | ${SITE.title}`}>
  <Header />
  <main
    data-backUrl={backUrl}
    id="main-content"
    class="w-full pb-12"
  >
    <div class="max-w-6xl mx-auto py-8 px-4 sm:px-8 xl:px-12">
      <!-- Page Header -->
      <div class="mb-10 border-b-2 border-border/60 pb-3">
        <div class="text-xs sm:text-sm font-mono text-heading2 tracking-widest uppercase">
          01 // INTEL &amp; WRITEUPS
        </div>
        <h1 class="m-0 text-3xl sm:text-4xl font-bold text-white tracking-wide flex items-center gap-1 mt-1">
          Posts <span class="text-accent animate-pulse">_</span>
        </h1>
      </div>

      {page.data.length === 0 ? (
        <p class="font-mono text-sm text-foreground/60 py-8">
          &gt; We haven't posted yet.
        </p>
      ) : (
        <ul class="divide-y divide-border/40">
          {page.data.map((post: any) => {
            const { id, filePath, data } = post;
            const { title, description, pubDatetime, modDatetime, timezone: tz, author, tags = [] } = data;
            const href = getPath(id, filePath);
            const dateStr = dayjs(modDatetime ?? pubDatetime)
              .tz(tz || SITE.timezone)
              .format("YYYY-MM-DD");

            return (
              <li class="py-7 first:pt-2 group">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs sm:text-sm font-mono text-foreground/65 mb-2.5">
                  <time class="text-heading2 font-bold">: {dateStr}</time>
                  {author && (
                    <span>| Author: <span class="text-foreground/85">{author}</span></span>
                  )}
                  {tags.length > 0 && (
                    <span class="flex flex-wrap items-center gap-1.5">
                      {tags.map((tag: string) => (
                        <a
                          href={`/tags/${slugifyStr(tag)}`}
                          class="inline-flex items-center justify-center leading-none text-xs text-heading2 hover:text-accent border border-border/60 hover:border-accent/50 rounded px-2 pt-[5px] pb-[3px] transition-colors"
                        >
                          [{tag}]
                        </a>
                      ))}
                    </span>
                  )}
                </div>

                <a href={href} class="inline-block">
                  <h2
                    transition:name={slugifyStr(title)}
                    class="text-xl sm:text-2xl font-bold text-white group-hover:text-accent transition-colors leading-snug hover:underline decoration-dashed underline-offset-4"
                  >
                    {title}
                  </h2>
                </a>

                {description && (
                  <p class="mt-2.5 text-sm text-foreground/80 leading-relaxed max-w-4xl">
                    {description}
                  </p>
                )}

                <div class="mt-3.5">
                  <a
                    href={href}
                    class="inline-flex items-center gap-1 text-xs sm:text-sm font-mono font-semibold text-heading2 hover:text-accent transition-colors"
                  >
                    READ MORE &gt;_
                  </a>
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </div>
  </main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
