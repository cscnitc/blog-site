---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";
import { slugifyStr } from "@/utils/slugify";

const events = await getCollection("events");
const sortedEvents = events.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const upcomingEvents = sortedEvents.filter((e) => e.data.type === "upcoming");
const pastEvents = sortedEvents.filter((e) => e.data.type === "past");

// Extract slug from id (filename without extension)
const getEventSlug = (id: string) => id.replace(/\.md$/, "");
---

<Layout title="Events | CTF & Operations">
  <Header />
  <main id="main-content" class="w-full pb-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-8 pt-8">
      <!-- Page Header -->
      <div class="mb-10 border-b-2 border-border/60 pb-3">
        <div class="text-xs sm:text-sm font-mono text-heading2 tracking-widest uppercase">
          02 // CTF &amp; OPERATIONS
        </div>
        <h1 class="m-0 text-3xl sm:text-4xl font-bold text-white tracking-wide flex items-center gap-1 mt-1">
          Events <span class="text-accent animate-pulse">_</span>
        </h1>
      </div>

      <!-- Upcoming Operations Timeline -->
      <section class="mb-14">
        <div class="mb-6 flex items-center gap-3">
          <div class="text-xs font-mono font-bold text-heading2 tracking-widest uppercase">
            // UPCOMING OPERATIONS
          </div>
          <div class="h-px flex-1 bg-border/40"></div>
        </div>

        {upcomingEvents.length === 0 ? (
          <div class="ml-3 sm:ml-4 border-l-2 border-border/60 pl-6 sm:pl-8 py-2 font-mono text-sm text-foreground/60">
            &gt; No upcoming operations scheduled at this time.
          </div>
        ) : (
          <ol class="relative border-l-2 border-accent/60 ml-3 sm:ml-4 pl-6 sm:pl-8 space-y-10">
            {upcomingEvents.map((event) => {
              const slug = getEventSlug(event.id);
              const eventHref = `/events/${slug}`;
              const actionHref =
                event.data.link && event.data.link !== "#" ? event.data.link : eventHref;

              return (
                <li class="relative group">
                  <!-- Timeline node -->
                  <span
                    class="absolute -left-[33px] sm:-left-[41px] top-1.5 h-4 w-4 rounded-full border-2 border-accent bg-accent shadow-[0_0_12px_rgba(0,255,65,0.8)]"
                    aria-hidden="true"
                  ></span>

                  <!-- Meta row -->
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs font-mono mb-1.5">
                    <time class="text-accent font-bold tracking-wider">
                      {event.data.date}
                    </time>
                    <span class="inline-flex items-center justify-center leading-none px-2 pt-[5px] pb-[3px] rounded border border-accent/60 bg-accent/15 text-accent font-bold text-[10px] tracking-widest uppercase whitespace-nowrap">
                      UPCOMING
                    </span>
                    {event.data.venue && (
                      <span class="text-foreground/70">
                        :: {event.data.venue}
                      </span>
                    )}
                    {event.data.time && (
                      <span class="text-foreground/60">
                        :: {event.data.time}
                      </span>
                    )}
                  </div>

                  <!-- Title -->
                  <a href={eventHref} class="inline-block">
                    <h2
                      transition:name={slugifyStr(event.data.title)}
                      class="text-xl sm:text-2xl font-bold text-white group-hover:text-accent transition-colors leading-snug hover:underline decoration-dashed underline-offset-4"
                    >
                      {event.data.title}
                    </h2>
                  </a>

                  <!-- Description -->
                  <p class="mt-2 text-xs sm:text-sm font-mono text-foreground/80 leading-relaxed max-w-3xl">
                    {event.body || "Join us for an in-depth technical exploration and hands-on laboratory exercises."}
                  </p>

                  <!-- Links -->
                  <div class="mt-3 flex flex-wrap items-center gap-3 text-xs font-mono">
                    <a
                      href={eventHref}
                      class="text-heading2 hover:text-accent font-bold transition-colors"
                    >
                      &gt; DETAILS_
                    </a>
                    {actionHref !== eventHref && (
                      <a
                        href={actionHref}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-accent hover:underline font-bold"
                      >
                        &gt; RSVP_ ↗
                      </a>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        )}
      </section>

      <!-- Past Operations Timeline -->
      <section>
        <div class="mb-6 flex items-center gap-3">
          <div class="text-xs font-mono font-bold text-heading2 tracking-widest uppercase">
            // TIMELINE ARCHIVE
          </div>
          <div class="h-px flex-1 bg-border/40"></div>
        </div>

        <ol class="relative border-l-2 border-border/70 ml-3 sm:ml-4 pl-6 sm:pl-8 space-y-10">
          {pastEvents.map((event) => {
            const slug = getEventSlug(event.id);
            const eventHref = `/events/${slug}`;

            return (
              <li class="relative group pb-2 border-b border-border/25 last:border-b-0">
                <!-- Timeline node -->
                <span
                  class="absolute -left-[33px] sm:-left-[41px] top-1.5 h-4 w-4 rounded-full border-2 border-border group-hover:border-accent bg-[#050805] group-hover:bg-accent/30 group-hover:shadow-[0_0_10px_rgba(0,255,65,0.6)] transition-all"
                  aria-hidden="true"
                ></span>

                <!-- Meta row -->
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs font-mono mb-1.5">
                  <time class="text-heading2 font-bold tracking-wider">
                    {event.data.date}
                  </time>
                  <span class="inline-flex items-center justify-center leading-none px-2 pt-[5px] pb-[3px] rounded border border-border/80 bg-muted/60 text-foreground/70 font-bold text-[10px] tracking-widest uppercase whitespace-nowrap">
                    PAST // OPS
                  </span>
                  {event.data.venue && (
                    <span class="text-foreground/65">
                      :: {event.data.venue}
                    </span>
                  )}
                  {event.data.rank && (
                    <span class="text-accent font-bold">
                      :: Rank: {event.data.rank}
                    </span>
                  )}
                </div>

                <!-- Title -->
                <a href={eventHref} class="inline-block">
                  <h2
                    transition:name={slugifyStr(event.data.title)}
                    class="text-lg sm:text-xl font-bold text-white group-hover:text-accent transition-colors leading-snug hover:underline decoration-dashed underline-offset-4"
                  >
                    {event.data.title}
                  </h2>
                </a>

                <!-- Description -->
                <p class="mt-2 text-xs sm:text-sm font-mono text-foreground/75 leading-relaxed max-w-3xl">
                  {event.body || "Technical session and hands-on security workshop."}
                </p>

                <!-- Links -->
                <div class="mt-3 flex flex-wrap items-center gap-4 text-xs font-mono pb-4">
                  <a
                    href={eventHref}
                    class="text-heading2 hover:text-accent font-bold transition-colors"
                  >
                    &gt; RECAP_
                  </a>
                  {event.data.writeups && (
                    <a
                      href={event.data.writeups}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-heading2 hover:text-accent font-bold transition-colors"
                    >
                      &gt; WRITEUPS ↗
                    </a>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
