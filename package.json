{
  "name": "blog-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist && cp -r dist/pagefind public/",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/astro/bin/astro.mjs';if(fs.existsSync(p)){let c=fs.readFileSync(p,'utf8');c=c.replace('const IS_STACKBLITZ = !!process.versions.webcontainer;','const IS_STACKBLITZ = true;');fs.writeFileSync(p,c);}\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.8",
    "dayjs": "^1.11.23",
    "lodash.kebabcase": "^4.1.1",
    "rehype-katex": "^7.0.1",
    "remark-collapse": "^0.1.2",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0",
    "satori": "^0.15.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@pagefind/default-ui": "^1.6.0",
    "@shikijs/transformers": "^3.23.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^16.5.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "unist-util-visit": "^5.2.0"
  }
}
